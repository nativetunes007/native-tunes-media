<div class="modal" id="modal" hidden role="dialog" aria-modal="true" aria-labelledby="mTitle">
  <div class="sheet">
    <div class="sheet-bar">
      <button type="button" class="back" id="mBack"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>Back to shop</button>
      <div class="bar-right">
        <button type="button" class="share-btn" id="mShare"><svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 8l5-5 5 5M5 13v6a2 2 0 002 2h10a2 2 0 002-2v-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Share</button>
        <button type="button" class="x" id="mClose" aria-label="Close">×</button>
      </div>
    </div>
    <div class="viewer" id="viewer">
      <div class="still" id="still" hidden><img id="stillImg" alt=""><div class="side-sw" id="sideSw" hidden onclick="event.stopPropagation()"><button type="button" data-s="both" aria-pressed="true">Front &amp; back</button><button type="button" data-s="back" aria-pressed="false">Back</button><button type="button" data-s="front" aria-pressed="false">Front</button></div></div>
      <div class="thumbs" id="thumbs" hidden></div>
      <span class="badge360" id="badge360">360° view</span>
      <div class="viewer-tools">
        <button type="button" class="tool" id="spinToggle">Pause spin</button>
        <button type="button" class="tool" id="zoomArt">Zoom into the art</button>
      </div>
      <div class="zoom-layer" id="zoomLayer" hidden><img id="zoomImg" alt=""></div>
    </div>
    <div class="info">
      <div class="info-top">
        <div style="display:flex;flex-direction:column;gap:4px">
          <h2 id="mTitle">Design</h2>
          <span class="from" id="mFrom"></span>
        </div>
      </div>
      <div class="price" id="mPrice">$29.99</div>
      <div class="opt"><span class="lbl">Item</span><div class="items" id="mItems"></div></div>
      <div class="opt"><span class="lbl">Color</span><div class="pills" id="mColors"></div></div>
      <div class="opt" id="sizeOpt"><span class="lbl">Size</span><div class="pills" id="mSizes"></div></div>
      <details class="sizeguide" id="sizeGuide"><summary>Size guide</summary><table id="sizeTable"></table><p class="note" style="margin-top:6px">Measured flat, in inches. Tip: lay a shirt you love flat and compare.</p></details>
      <p class="bundle-hint" id="bundleHint">Bundle &amp; save: add any mug with a tee and save $5 on the mug. Free US shipping on orders $75+, plus a limited-time extra 10% off orders $100+.</p>
      <button type="button" class="btn btn-gold" id="addCart">Add to cart</button>
      <a class="listen-mini" id="mListen" target="_blank" rel="noopener"><img alt="" id="mListenImg"><div><small>From the channel · listen while you shop</small><span id="mListenTitle"></span></div></a>
      <p class="care" id="mCare"></p>
    </div>
  </div>
</div>

<div class="acct-modal" id="acctModal" hidden role="dialog" aria-modal="true" aria-labelledby="acctTitle"><div class="acct-card"><button type="button" class="acct-x" id="acctClose" aria-label="Close">×</button><div id="acctBody"></div></div></div>
<aside class="drawer" id="drawer" hidden aria-label="Cart">
  <div style="display:flex;justify-content:space-between;align-items:center"><h2>Your cart</h2><button type="button" class="x" id="dClose" aria-label="Close cart">×</button></div>
  <div class="lines" id="lines"></div>
  <div class="ship-prog" id="shipProg"></div>
  <div class="promo" id="promoBox"><label for="promoInput">Promo code</label><div class="promo-row"><input id="promoInput" placeholder="WELCOME10" autocomplete="off" maxlength="40"><button type="button" id="promoApply">Apply</button></div><p class="note" id="promoMsg" style="margin-top:6px"></p></div>
  <div class="sum-lines" id="sumLines"></div>
  <div class="total"><span>Estimated total</span><span id="subtotal">$0.00</span></div>
  <div class="acct-offer" id="acctOffer"></div>
  <button type="button" class="btn btn-gold" id="checkout">Checkout</button>
