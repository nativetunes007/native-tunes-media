<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script>
(function(){
"use strict";
const reduce = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;

/* ---------- catalog ---------- */
const ITEMS = {
  tee:    {label:"Tee",        price:29.99, apparel:true},
  hoodie: {label:"Hoodie",     price:49.99, apparel:true},
  mug:    {label:"Mug",        price:16.99},
  poster: {label:"Poster",     price:19.99},
  tote:   {label:"Tote",       price:21.99},
  sticker:{label:"Sticker",    price:4.99},
  phone:  {label:"Phone case", price:22.99}
};
const ALL = ["tee","hoodie","mug"];
const DESIGNS = [
  {id:"d1",name:"Moonlit Campfire",img:"img/d1.png",cut:true,tag:"nature",from:"From our fire and flute sleep videos",colors:["Black","White","Heather Gray"]},
  {id:"d2",name:"432 Hz Mountains",img:"img/d2.png",cut:true,tag:"nature",from:"From our 432 Hz healing frequency videos",colors:["Black","White","Heather Gray"]},
  {id:"d3",name:"Keep Dreaming",img:"img/d3k.webp",cut:true,tag:"nature",from:"Earth glowing beside the Milky Way",colors:["Black","White","Heather Gray"]},
  {id:"n1",name:"Purple Mountain Majesty",img:"img/n1.webp",cut:true,tag:"nature",from:"Snowy peaks glowing at a purple sunrise",colors:["Purple","Black","White","Heather Gray"]},
  {id:"n2",name:"Gold of the Gods",img:"img/n2.webp",cut:true,tag:"faith",from:"Anubis and Horus guarding a mountain of gold",colors:["Black","White","Heather Gray"]},
  {id:"d5",name:"Inhale Exhale",img:"img/d5n.webp",cut:true,tag:"nature",from:"Native-style flute in turquoise water",colors:["Black","White","Heather Gray"]},
  {id:"d7",name:"Native Tunes Logo",img:"img/d7.png",cut:true,tag:"logo",from:"The Native Tunes mark",colors:["Navy","Black","White","Heather Gray"],items:["tee","hoodie","mug"]},
  {id:"g1",name:"Written in the Stars",img:"img/g1.webp",cut:true,tag:"goddess",from:"Celestial goddess with headphones",colors:["Black","White","Heather Gray"]},
  {id:"g2",name:"Strength in Stillness",img:"img/g2.webp",cut:true,tag:"goddess",from:"White and gold warrior goddess",colors:["Black","White","Heather Gray"]},
  {id:"g3",name:"Trust Your Intuition",img:"img/g3.webp",cut:true,tag:"goddess",from:"Snow owl queen with headphones",colors:["Black","White","Heather Gray"]},
  {id:"g4",name:"Howl at the Moon",img:"img/g4.webp",cut:true,tag:"nature",from:"Wolf, full moon and waterfalls",colors:["Black","White","Heather Gray"]},
  {id:"g5",name:"Cosmic Healing",img:"img/g5.webp",cut:true,tag:"goddess",from:"The cosmic alchemist",colors:["Black","White","Heather Gray"]},
  {id:"g6",name:"Queen Energy",img:"img/g6.webp",cut:true,tag:"goddess",from:"Neon pharaoh queen",colors:["Black","White","Heather Gray"]},
  {id:"g7",name:"Let the Music Heal · Feathers",img:"img/g7.webp",cut:true,tag:"goddess",from:"Feather bonnet, headphones and wolf",colors:["Black","White","Heather Gray"]},
  {id:"g8",name:"Tune In",img:"img/g8.webp",cut:true,tag:"goddess",from:"Feather bonnet portrait with headphones",colors:["Black","White","Heather Gray"]},
  {id:"r1",name:"Grateful",img:"img/r1.webp",cut:true,tag:"faith",from:"Neon angel wings",colors:["Black","White","Heather Gray"]},
  {id:"r2",name:"Manifest",img:"img/r2.webp",cut:true,tag:"faith",from:"Fire and water spirit",colors:["Black","White","Heather Gray"]},
  {id:"r3",name:"Cosmic Energy",img:"img/r3n.webp",cut:true,tag:"faith",from:"Giza pyramids charging under Orion's Belt",colors:["Black","White","Heather Gray"]},
  {id:"p1",name:"Spider Frenchie",img:"img/p1.webp",cut:true,tag:"pets",from:"Our French bulldog in his red hoodie",colors:["Black","White","Heather Gray"]},
  {id:"p2",name:"Raccoon DJ",img:"img/p2.webp",cut:true,tag:"pets",from:"A raccoon on the turntables",colors:["Black","White","Heather Gray"]},
  {id:"p4",name:"Bitcoin Raccoon",img:"img/p4.webp",cut:true,tag:"faith",from:"Abundance: a raccoon in a sea of gold coins",colors:["Black","White","Heather Gray"]},
  {id:"p3",name:"Machete Penguin",img:"img/p3.webp",cut:true,tag:"pets",from:"Penguin in sunglasses and gold headphones",colors:["Black","White","Heather Gray"]},
  {id:"o1",name:"Bat Escape Texas",img:"img/o1.webp",cut:true,tag:"texas",from:"Hand-drawn Native Tunes original",colors:["Black","White","Heather Gray","Kelly Green"]},
  {id:"o2",name:"America Flag",img:"img/o2.webp",cut:true,tag:"texas",from:"Hand-drawn Native Tunes original",colors:["Black","White","Heather Gray"]},
  {id:"o4",name:"Austin Native Soccer",img:"img/o4.webp",cut:true,tag:"texas",from:"Hand-drawn Native Tunes original",colors:["White","Heather Gray"]},
  {id:"o5",name:"Austin Skyline",img:"img/o5.webp",cut:true,tag:"texas",from:"Hand-drawn Native Tunes original",colors:["White","Heather Gray"]},
];
const COLOR_HEX = {Black:"#18181b",White:"#f4f4f1",Navy:"#1b2342","Heather Gray":"#b0b0ad","Kelly Green":"#0a7e46",Purple:"#3a2462",Natural:"#ece2cc"};
const FILTERS = [["goddess","Goddesses & queens"],["nature","Sounds & nature"],["faith","Faith & abundance"],["pets","Animals"],["texas","Texas & USA"],["logo","Logo"],["all","All designs"]];
const money = n => "$" + n.toFixed(2);
const $ = s => document.querySelector(s);

/* ---------- toast ---------- */
let toastT;
function toast(msg){const t=$("#toast");t.textContent=msg;t.hidden=false;clearTimeout(toastT);toastT=setTimeout(()=>t.hidden=true,2400);}

/* ---------- router (pages + shareable product links like #shop/p1) ---------- */
const PAGES = ["home","shop","listen","about","contact","shipping","terms","privacy","disclaimer"];
let lastPage = null;
function route(){
  const raw = (location.hash||"").replace("#","") || location.pathname.replace(/^\/+|\/+$/g,"");
  const parts = raw.split("/");
  const h = parts[0];
  const p = PAGES.includes(h) ? h : "home";
  const pid = (p==="shop" && parts[1] && DESIGNS.some(d=>d.id===parts[1])) ? parts[1] : null;
  document.querySelectorAll(".page").forEach(s=>s.classList.toggle("on", s.id==="page-"+p));
  document.querySelectorAll("[data-nav]").forEach(a=>{ if(a.dataset.nav===p) a.setAttribute("aria-current","page"); else a.removeAttribute("aria-current"); });
  if (h==="join"){ setTimeout(()=>{ const j=document.getElementById("join"); if(j) j.scrollIntoView({behavior:reduce?"auto":"smooth",block:"center"}); },60); }
  else if (p!==lastPage && !pid) window.scrollTo(0,0);
  lastPage = p;
  if (p==="home") sky.start(); else sky.stop();
  if (window.bgm) bgm.page(["home","shop","listen","about","contact"].includes(p));
  if (pid){ if($("#modal").hidden || !cur || cur.id!==pid) openModal(pid, true, {item:parts[2], color:parts[3]}); }
  else if (!$("#modal").hidden){ modalPushed=false; hideModal(); }
}

/* soft background music on home, shop, listen, about and contact (flute & waterfall sample from our most-watched video) */
window.bgm = (function(){
  const a=$("#bgm"), btn=$("#soundBtn"), lbl=$("#soundLbl"), VOL=0.12;
  let muted=false, onHome=true, started=false;
  try{ muted = localStorage.getItem("nt_sound")==="off"; }catch(e){}
  a.volume=0;
  function fade(to,ms){ const from=a.volume, t0=performance.now(); (function step(){ const k=Math.min(1,(performance.now()-t0)/ms); a.volume=from+(to-from)*k; if(k<1) requestAnimationFrame(step); else if(to===0) a.pause(); })(); }
  function ui(){ btn.hidden=!onHome; lbl.textContent = (muted||!started) ? "Play music" : "Mute music"; btn.setAttribute("aria-pressed", String(!muted && started)); }
  function play(){ if(muted||!onHome) return; a.play().then(()=>{ started=true; fade(VOL,2500); ui(); }).catch(()=>{ ui(); }); }
  function firstTouch(){ ["pointerdown","keydown","touchstart"].forEach(e=>removeEventListener(e,firstTouch,true)); if(!started) play(); }
  ["pointerdown","keydown","touchstart"].forEach(e=>addEventListener(e,firstTouch,true));
  btn.addEventListener("click",e=>{ e.stopPropagation(); if(muted||!started){ muted=false; try{localStorage.setItem("nt_sound","on");}catch(_){} play(); } else { muted=true; try{localStorage.setItem("nt_sound","off");}catch(_){} fade(0,600); } ui(); });
  document.addEventListener("visibilitychange",()=>{ if(document.hidden) a.pause(); else if(started && !muted && onHome) a.play().catch(()=>{}); });
  setTimeout(play,400);
  return { page(home){ onHome=home; if(!home){ if(!a.paused) fade(0,500); } else if(started && !muted){ a.play().then(()=>fade(VOL,1500)).catch(()=>{}); } ui(); } };
})();
window.addEventListener("hashchange", route);

/* ---------- shared product helpers ---------- */
DESIGNS.sort((a,b)=>a.name.localeCompare(b.name, "en", {numeric:true}));
const slug = c => c.toLowerCase().replace(/ /g,"-");
const isApparel = it => it==="tee" || it==="hoodie";
const itemColors = (d,item) => item==="hoodie" ? d.colors.filter(c=>c!=="Kelly Green") : d.colors;
const MV = "1029b";
const mock = (d,item,color) => "img/m/"+d.id+"-"+item+"-"+slug(color)+".webp?v="+MV;
/* designs whose ink changes with the shirt color (white web on black, black web on light, etc.) */
function artFor(d, color, item){
  const dark = color==="Black" || color==="Navy" || color==="Purple" || item==="poster" || item==="phone";
  if (d.id==="d3"||d.id==="d5"||d.id==="r3"||d.id==="n1"||d.id==="n2") return (dark || color==="Kelly Green") ? d.img : d.img.replace(".webp","_l.webp");
  if (d.id==="p1") return dark ? "img/p1.webp" : "img/p1_b.webp";
  if (d.id==="d4") return dark ? "img/d4.png" : "img/d4_l.png";
  if (d.id==="o1") return color==="Black" ? "img/o1_d.webp" : color==="Kelly Green" ? "img/o1_k.webp" : "img/o1.webp";
  return d.img;
}
function cardColor(d){ if(d.id==="o1"&&shirt==="Black") return "Kelly Green"; if(d.id==="n1"&&shirt==="Black") return "Purple"; return d.colors.includes(shirt) ? shirt : d.colors[0]; }

/* ---------- home: New Releases ---------- */
const featGrid = $("#featGrid");
["d5","g7","d3","r1","r3","p2","p3","n1","g4","n2","p1"].forEach(id=>{
  const d = DESIGNS.find(x=>x.id===id), col = d.colors[0];
  const b = document.createElement("button"); b.type="button"; b.className="tilt";
  b.innerHTML = '<span class="flag">New</span><span class="art"><img loading="lazy" width="900" height="900" alt="" src="'+mock(d,"tee",col)+'"></span><b></b>';
  b.querySelector("b").textContent = d.name; b.querySelector("img").alt = d.name+" t-shirt in "+col.toLowerCase();
  b.addEventListener("click",()=>openModal(d.id));
  if(!reduce){
    b.addEventListener("pointermove",e=>{const r=b.getBoundingClientRect();const x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;b.style.transform="rotateY("+(x*12)+"deg) rotateX("+(-y*9)+"deg)";});
    b.addEventListener("pointerleave",()=>b.style.transform="");
  }
  featGrid.appendChild(b);
});

/* ---------- listen page ---------- */
const VIDS = [["rjovJk6Hsug", "Fall Asleep Fast 🌙 432 Hz Singing Bowls & Gentle Rain · Deep Sleep Music · 8 Hours Black Screen", "8 hr 0 min"], ["LQC4YoMOFgI", "Thank You God 🙏 The Best Is Yet To Come | Meditation Affirmations Black Screen 1111", "17 min"], ["hVEMMtqnd6w", "Money & Abundance Affirmations ✨ Unlock the Universe | Wave Sounds Meditation (Black Screen 888)", "18 min"], ["YA5es8mrvaQ", "Make It Rain 💸 Prosperity & Money Affirmations | Calming Rain Sounds (Black Screen 888)", "18 min"], ["N-iNc-HgtRE", "Thank You God 🙏 Morning Gratitude Affirmations | Ocean Waves Meditation (1111)", "18 min"], ["GHBE-wYqalI", "I Am Wealthy, Abundant & Healthy ✨ Positive Affirmations for Meditation | Black Screen (888)", "17 min"], ["AQqC4Dpicis", "Health Is Wealth 🌿 Powerful Health Affirmations for Meditation | Waterfall Sounds (555)", "17 min"], ["THTsVSDhexE", "Manifest Success & Abundance ✨ Powerful Affirmations for Meditation | Waterfall Sounds (999)", "17 min"], ["a5yyCjelC1o", "Lottery Abundance Manifestation ✨ Powerful Affirmations with Ocean Waves | Sleep & Meditation (777)", "17 min"], ["kWhpzcWpQM0", "Unlock Money Abundance 💰 432Hz Affirmations with Ocean Waves | Sleep & Meditation (Black Screen) 777", "17 min"], ["W4y20nSe77w", "Money Abundance Affirmations 💰 432Hz Waterfall Sounds | Deep Sleep & Meditation (Black Screen) 444", "20 min"], ["H_JIOlExdLc", "Fall Asleep Fast 🌙 Deep Sleep Meditation 432Hz ✨ Relaxing Indian Flute Waterfall Black Screen Meditation", "9 hr 4 min"], ["bDNseOPRsGg", "Fall Asleep Fast 🌙 Deep Sleep 528Hz Healing Music 🌿 Native Flute & Waterfall Sounds | Black Screen", "8 hr 15 min"], ["_xkVhfNilaI", "Deep Sleep & Pineal Healing 🌙 | 963 Hz Solfeggio Frequency | Binaural Beats + Waterfall Black Screen", "10 hr 40 min"], ["gfCPkLQdlvo", "432 Hz Healing Sleep Music • Chakra Activation | Black Screen", "9 hr 40 min"], ["3eJIPAVQwN8", "Deep Sleep Meditation • 963 Hz Solfeggio Healing Frequency (Black Screen)", "5 hr 33 min"], ["T3mZhix_308", "432 Hz Binaural Beats for Deep Sleep • Healing Water Sounds (Black Screen)", "7 hr 17 min"], ["kIO3OXpDhM4", "Fall Asleep Fast 🌙 Deep Sleep Meditation • 432 Hz Chakra Activation (Black Screen)", "3 hr 0 min"], ["kMPn6pz-Os0", "Fall Asleep Fast Deep Sleep Music Sound Bath • 528 Hz Healing Frequency | Singing Bowls Black Screen", "7 hr 30 min"], ["CHvJvQC1JUw", "Fall Asleep Fast 🌙 Deep Sleep Music • 528 Hz Native Flute & Fire Sounds (Black Screen)", "5 hr 3 min"], ["Z6p7B7VKaWk", "Deep Sleep Music 🌙 • 528 Hz Chakra Cleanse & Healing (Black Screen)", "21 min"], ["fM3JohjK7OQ", "Fall Asleep Fast 🌙 Deep Sleep Nature Sounds • 432 Hz Tropical Jungle & Flowing River Black Screen", "3 hr 22 min"], ["Ko2CNT0wx9s", "Fall Asleep Fast 🌙 Deep Sleep Meditation Fireplace Sounds • Relaxing Firelog Ambience (Black Screen)", "3 hr 0 min"], ["VGvNj6tGXog", "Spiritual Healing Meditation • 432 Hz Frequency Tunes (Black Screen)", "3 hr 12 min"], ["AoZg6VEqOLA", "Fall Asleep Fast 🌙 Deep Sleep Music • 432 Hz 🌧 Rain & Thunder Sounds (Black Screen)", "4 hr 0 min"], ["goKTCJ8fKIw", "Fall Asleep Fast 🌙 Deep Sleep Music • 432 Hz River Sounds for Healing (Black Screen)", "6 hr 5 min"], ["LUbzQzFMyR0", "Deep Healing Meditation 🌙 • 432 Hz & 528 Hz Deep Relaxation (Black Screen)", "3 hr 37 min"], ["4vbXrmfOyiI", "Fall Asleep Fast 🌙 Deep Sleep Music • 528 Hz 🌊 Ocean Waves for Healing (Black Screen)", "4 hr 20 min"], ["8u3sv4pJK1k", "Zen Meditation 🌙 • 432 Hz Tibetan Singing Bowls (Black Screen)", "4 hr 27 min"], ["gI-uTdCoTeM", "Fall Asleep Fast 🌙 Deep Relaxation Music • 432 Hz Waterfall, Indian Flute & Tibetan Bowls Black Screen", "3 hr 12 min"], ["XB0XtTYh17w", "Deep Sleep Music • 528 Hz Healing Waterfall Sounds (Black Screen)", "6 min"], ["ikl-C_q5wUg", "Native Tunes 432 Hz Waterfall Tibetan Bowl Ultimate Relaxation Nature Sounds", "10 min"]];
const PLAYLISTS = [["PLYss8EAwPsIc", "Fall Asleep Fast 🌙 Deep Sleep Music", "11 videos · black screen", "rjovJk6Hsug"], ["PLBNE2INTOdpI", "Sleep Frequencies 🌙 432, 528 & 963 Hz", "17 videos · black screen", "_xkVhfNilaI", 1.55], ["PLGozMvrKsVG4", "Abundance & Gratitude Affirmations ✨", "10 videos · meditation", "M1wiFvbFQnQ"], ["PLFnzyobXdksq4dnuQ_JFI2TFOtSguVhPg", "Deep Sleep & Healing Frequencies 🌙", "28 videos · black screen", "LQC4YoMOFgI", 1.6]];
const esc=t=>t.replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
$("#vidCount").textContent = "("+VIDS.length+")";
$("#vidGrid").innerHTML = VIDS.map(v=>'<a class="vid glass" target="_blank" rel="noopener" href="https://www.youtube.com/watch?v='+v[0]+'"><span class="thumb"><img src="https://i.ytimg.com/vi/'+v[0]+'/hqdefault.jpg" alt="" loading="lazy"><em>'+v[2]+'</em></span><span>'+esc(v[1])+'</span></a>').join("");
$("#plGrid").innerHTML = PLAYLISTS.map(p=>'<a class="pl glass" target="_blank" rel="noopener" href="https://www.youtube.com/playlist?list='+p[0]+'" aria-label="Open the '+esc(p[1])+' playlist on YouTube"><span class="pl-thumb'+(p[4]?' pillar':'')+'"'+(p[4]?' style="--z:'+p[4]+'"':'')+'>'+(p[4]?'<img class="bg" loading="lazy" alt="" src="https://i.ytimg.com/vi/'+p[3]+'/mqdefault.jpg">':'')+'<img class="fg" loading="lazy" alt="" src="https://i.ytimg.com/vi/'+p[3]+'/maxresdefault.jpg" onload="if(this.naturalWidth<200&&this.src.indexOf(\'maxres\')>0)this.src=this.src.replace(\'maxresdefault\',\'mqdefault\')" onerror="this.onerror=null;this.src=this.src.replace(\'maxresdefault\',\'mqdefault\')"><span class="pl-count"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h13v2H3zm0 5h13v2H3zm0 5h9v2H3zm14-1v-5l5 3.5z" fill="currentColor"/></svg>'+p[2].split(" · ")[0]+'</span><span class="pl-play">▶ Play all</span></span><b>'+esc(p[1])+'</b><small>'+p[2]+' · opens on YouTube</small></a>').join("");

/* ---------- shop grid (A to Z) ---------- */
let filter = "all", shirt = "Black";
const chips = $("#chips");
FILTERS.forEach(([k,l])=>{const c=document.createElement("button");c.type="button";c.className="chip";c.textContent=l;c.setAttribute("aria-pressed",k===filter);c.onclick=()=>{filter=k;chips.querySelectorAll(".chip").forEach(x=>x.setAttribute("aria-pressed",x===c));renderGrid();};chips.appendChild(c);});
document.querySelectorAll("[data-shirt]").forEach(s=>s.addEventListener("click",()=>{shirt=s.dataset.shirt;document.querySelectorAll("[data-shirt]").forEach(x=>x.setAttribute("aria-pressed",x===s));renderGrid();}));
function renderGrid(){
  const g = $("#shopGrid"); g.innerHTML = "";
  DESIGNS.filter(d=>filter==="all"||d.tag===filter).forEach(d=>{
    const col = cardColor(d);
    const b = document.createElement("button"); b.type="button"; b.className="card";
    b.innerHTML = '<span class="tee"><img loading="lazy" width="900" height="900" alt="" src="'+mock(d,"tee",col)+'"></span><b></b><span class="dots">'+d.colors.map(c=>'<i title="'+c+'" style="background:'+COLOR_HEX[c]+'"></i>').join("")+'</span><span class="meta"><span>'+col+' tee · hoodie, mug &amp; more</span></span>';
    b.querySelector("b").textContent = d.name; b.querySelector("img").alt = d.name+" t-shirt in "+col.toLowerCase();
    b.addEventListener("click",()=>openModal(d.id));
    g.appendChild(b);
  });
}

/* ---------- 3D product builder ---------- */
const texCache = {};
function loadTex(src){ if(!texCache[src]){ const t=new THREE.TextureLoader().load(src, ()=>{}); t.encoding=THREE.sRGBEncoding; t.anisotropy=8; texCache[src]=t; } return texCache[src]; }
function teeShape(hoodie){
  const s = new THREE.Shape();
  const P = hoodie
    ? [[90,12],[50,26],[-4,150],[30,166],[66,96],[66,330],[234,330],[234,96],[270,166],[304,150],[250,26],[210,12]]
    : [[90,12],[58,22],[8,62],[40,112],[70,96],[70,312],[230,312],[230,96],[260,112],[292,62],[242,22],[210,12]];
  const f = p => [(p[0]-150)/100, -(p[1]-170)/100];
  s.moveTo(...f(P[0])); P.slice(1).forEach(p=>s.lineTo(...f(p)));
  s.quadraticCurveTo(...f([150,52]), ...f([90,12]));
  return s;
}
function fabric(hex){ return new THREE.MeshStandardMaterial({color:hex, roughness:.92, metalness:0}); }
function artPlane(src, w, h, cut){ const m=new THREE.MeshStandardMaterial({map:loadTex(src), transparent:!!cut, roughness:.8}); return new THREE.Mesh(new THREE.PlaneGeometry(w,h), m); }
function roundRectShape(w,h,r){ const s=new THREE.Shape(),x=-w/2,y=-h/2; s.moveTo(x+r,y); s.lineTo(x+w-r,y); s.quadraticCurveTo(x+w,y,x+w,y+r); s.lineTo(x+w,y+h-r); s.quadraticCurveTo(x+w,y+h,x+w-r,y+h); s.lineTo(x+r,y+h); s.quadraticCurveTo(x,y+h,x,y+h-r); s.lineTo(x,y+r); s.quadraticCurveTo(x,y,x+r,y); return s; }
function mugTexture(src, baseHex){
  const c = document.createElement("canvas"); c.width=2048; c.height=744; const g=c.getContext("2d");
  g.fillStyle=baseHex; g.fillRect(0,0,c.width,c.height);
  const tex = new THREE.CanvasTexture(c); tex.encoding=THREE.sRGBEncoding;
  const im = new Image(); im.onload=()=>{ const s=600; g.drawImage(im,(c.width-s)/2,(c.height-s)/2,s,s); tex.needsUpdate=true; }; im.src=src;
  return tex;
}
function buildProduct(type, d, colorName){
  const hex = COLOR_HEX[colorName] || "#18181d";
  const grp = new THREE.Group();
  if (type==="tee" || type==="hoodie"){
    const hood = type==="hoodie";
    /* flat garment: thin like a real shirt laid out, printed on the front */
    const geo = new THREE.ExtrudeGeometry(teeShape(hood), {depth:.03, bevelEnabled:true, bevelThickness:.012, bevelSize:.012, bevelSegments:2, curveSegments:24});
    geo.center(); grp.add(new THREE.Mesh(geo, fabric(hex)));
    const art = artPlane(d.img, .92, .92, d.cut); art.position.set(0,.3,.031); grp.add(art);
    if (hood){
      const h = new THREE.Mesh(new THREE.TorusGeometry(.42,.11,16,40,Math.PI), fabric(hex)); h.scale.z=.22; h.position.set(0,1.32,-.01); grp.add(h);
      const p = new THREE.Mesh(new THREE.BoxGeometry(1.1,.42,.008), fabric(hex)); p.position.set(0,-.95,.031); grp.add(p);
      art.position.y=.22;
    }
  } else if (type==="mug"){
    const base = colorName==="White"||colorName==="Natural" ? "#f7f7f5" : hex;
    const body = new THREE.Mesh(new THREE.CylinderGeometry(.72,.72,1.6,96,1,true,Math.PI,Math.PI*2), new THREE.MeshStandardMaterial({map:mugTexture(d.img, base), roughness:.25, metalness:.05, side:THREE.FrontSide}));
    grp.add(body);
    const inner = new THREE.Mesh(new THREE.CylinderGeometry(.68,.68,1.58,64,1,true), new THREE.MeshStandardMaterial({color:base, roughness:.3, side:THREE.BackSide})); grp.add(inner);
    const bottom = new THREE.Mesh(new THREE.CircleGeometry(.72,64), new THREE.MeshStandardMaterial({color:base, roughness:.3})); bottom.rotation.x=-Math.PI/2; bottom.position.y=-.78; grp.add(bottom);
    const rim = new THREE.Mesh(new THREE.TorusGeometry(.7,.025,12,96), new THREE.MeshStandardMaterial({color:base, roughness:.25})); rim.rotation.x=Math.PI/2; rim.position.y=.8; grp.add(rim);
    const handle = new THREE.Mesh(new THREE.TorusGeometry(.36,.085,16,48,Math.PI), new THREE.MeshStandardMaterial({color:base, roughness:.25})); handle.rotation.z=-Math.PI/2; handle.position.x=.72; grp.add(handle);
  } else if (type==="poster"){
    const frame = new THREE.Mesh(new THREE.BoxGeometry(1.86,2.46,.08), new THREE.MeshStandardMaterial({color:"#1b1b1f", roughness:.6})); grp.add(frame);
    const paper = new THREE.Mesh(new THREE.PlaneGeometry(1.7,2.3), new THREE.MeshStandardMaterial({color:d.cut?"#0b1230":"#111", roughness:.9})); paper.position.z=.045; grp.add(paper);
    const art = artPlane(d.img, 1.5, 1.5, d.cut); art.position.set(0,.18,.05); grp.add(art);
  } else if (type==="tote"){
    const bag = new THREE.Mesh(new THREE.BoxGeometry(1.7,1.8,.14), fabric(colorName==="Navy"?COLOR_HEX.Navy:COLOR_HEX.Natural)); grp.add(bag);
    [-.42,.42].forEach(x=>{ const h=new THREE.Mesh(new THREE.TorusGeometry(.32,.045,12,40,Math.PI), fabric(colorName==="Navy"?COLOR_HEX.Navy:"#d9cdb0")); h.position.set(x,.9,0); grp.add(h); });
    const art = artPlane(d.img, 1.15, 1.15, d.cut); art.position.set(0,-.05,.075); grp.add(art);
  } else if (type==="sticker"){
    const disk = new THREE.Mesh(new THREE.CylinderGeometry(1,1,.03,96), new THREE.MeshStandardMaterial({color:"#ffffff", roughness:.4})); disk.rotation.x=Math.PI/2; grp.add(disk);
    const art = artPlane(d.img, 1.8, 1.8, d.cut); art.position.z=.02; grp.add(art);
  } else if (type==="phone"){
    const geo = new THREE.ExtrudeGeometry(roundRectShape(1.15,2.35,.2), {depth:.12, bevelEnabled:true, bevelThickness:.03, bevelSize:.03, bevelSegments:3}); geo.center();
    grp.add(new THREE.Mesh(geo, new THREE.MeshStandardMaterial({color:"#0e0e12", roughness:.35})));
    const art = artPlane(d.img, 1.1, 1.1, d.cut); art.position.set(0,-.15,-.1); art.rotation.y=Math.PI; grp.add(art);
    const cam = new THREE.Mesh(new THREE.BoxGeometry(.42,.42,.06), new THREE.MeshStandardMaterial({color:"#222", roughness:.3})); cam.position.set(-.3,.85,-.12); grp.add(cam);
    grp.rotation.y = Math.PI;
  }
  return grp;
}

/* ---------- reusable viewer ---------- */
function makeViewer(host, opts){
  const renderer = new THREE.WebGLRenderer({antialias:true, alpha:true});
  renderer.setPixelRatio(Math.min(devicePixelRatio,2)); renderer.outputEncoding=THREE.sRGBEncoding;
  renderer.domElement.setAttribute("aria-label", "3D product view, drag to rotate");
  host.prepend(renderer.domElement);
  const scene = new THREE.Scene();
  const cam = new THREE.PerspectiveCamera(35,1,.1,100); cam.position.set(0,.2,6.2);
  scene.add(new THREE.HemisphereLight(0xffffff, 0x8a8f9e, .9));
  const key = new THREE.DirectionalLight(0xffffff,.9); key.position.set(3,4,5); scene.add(key);
  const rim = new THREE.DirectionalLight(0xbfd4ff,.5); rim.position.set(-4,2,-4); scene.add(rim);
  const ctl = new THREE.OrbitControls(cam, renderer.domElement);
  ctl.enableDamping=true; ctl.enablePan=false; ctl.enableZoom=!!opts.zoom; ctl.minDistance=2.4; ctl.maxDistance=9;
  ctl.autoRotate=!reduce; ctl.autoRotateSpeed=opts.speed||2.2;
  ctl.addEventListener("start",()=>{ if(opts.stopOnDrag){ ctl.autoRotate=false; opts.onStop&&opts.onStop(); } });
  let obj=null, running=false, raf=0;
  function size(){ const r=host.getBoundingClientRect(); if(!r.width) return; renderer.setSize(r.width,r.height,false); cam.aspect=r.width/r.height; cam.updateProjectionMatrix(); }
  function loop(){ if(!running) return; ctl.update(); renderer.render(scene,cam); raf=requestAnimationFrame(loop); }
  window.addEventListener("resize", size);
  return {
    set(o){ if(obj) scene.remove(obj); obj=o; scene.add(o); },
    start(){ if(running) return; running=true; size(); loop(); },
    stop(){ running=false; cancelAnimationFrame(raf); },
    ctl, size
  };
}

/* home video: plays in place (no autoplay with sound until tapped) */
$("#homeVideo").addEventListener("click",e=>{
  e.preventDefault(); const card=e.currentTarget; if(card.querySelector("iframe")) return;
  try{ const a=document.getElementById("bgm"); if(a) a.pause(); }catch(_){}
  const f=document.createElement("iframe");
  f.src="https://www.youtube-nocookie.com/embed/rjovJk6Hsug?autoplay=1&rel=0&playsinline=1";
  f.title="Fall Asleep Fast: 432 Hz singing bowls and gentle rain"; f.allow="autoplay; encrypted-media; picture-in-picture; fullscreen"; f.allowFullscreen=true;
  card.querySelectorAll("img,.play").forEach(n=>n.remove()); card.appendChild(f);
});
