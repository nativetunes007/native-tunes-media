</aside>
<button type="button" class="sound-btn" id="soundBtn" hidden aria-pressed="false"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path id="soundIcon" d="M3 9v6h4l5 5V4L7 9H3z" fill="currentColor"/></svg><span id="soundLbl">Play music</span></button>
