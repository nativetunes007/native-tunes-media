/* ---------- home sky: twinkling stars, shooting stars and a comet (2D canvas, round soft stars) ---------- */
const sky = (function(){
  const c = $("#sky"), g = c.getContext("2d");
  let W=0, H=0, dpr=1, stars=[], shots=[], comet=null, running=false, raf=0, last=0, t=0, nextShot=2.5, nextComet=5;
  const TINTS = ["255,247,228","226,236,255","255,232,200","240,232,255","255,255,255"];
  function seed(){
    const n = Math.min(700, Math.round(W*H/2300)); stars = [];
    for(let i=0;i<n;i++){
      const big = Math.random()<.07;
      stars.push({x:Math.random()*W, y:Math.random()*H, r: big ? 1.1+Math.random()*1.2 : .3+Math.random()*.75,
        ph:Math.random()*6.283, sp:.5+Math.random()*1.9, tint:TINTS[(Math.random()*TINTS.length)|0], big});
    }
  }
  function size(){ dpr=Math.min(window.devicePixelRatio||1,2); W=innerWidth; H=innerHeight; c.width=Math.round(W*dpr); c.height=Math.round(H*dpr); g.setTransform(dpr,0,0,dpr,0,0); seed(); }
  function drawStars(){
    for(const s of stars){
      const tw = .5+.5*Math.sin(t*s.sp+s.ph), a = .25+.75*tw*tw;
      if(s.big){
        const R = s.r*5.5, gr = g.createRadialGradient(s.x,s.y,0,s.x,s.y,R);
        gr.addColorStop(0,"rgba("+s.tint+","+(.9*a)+")"); gr.addColorStop(.25,"rgba("+s.tint+","+(.28*a)+")"); gr.addColorStop(1,"rgba("+s.tint+",0)");
        g.fillStyle=gr; g.beginPath(); g.arc(s.x,s.y,R,0,6.283); g.fill();
        const L = s.r*(5+5*tw); g.strokeStyle="rgba("+s.tint+","+(.45*a)+")"; g.lineWidth=.6;
        g.beginPath(); g.moveTo(s.x-L,s.y); g.lineTo(s.x+L,s.y); g.moveTo(s.x,s.y-L); g.lineTo(s.x,s.y+L); g.stroke();
      }
      g.fillStyle="rgba("+s.tint+","+a+")"; g.beginPath(); g.arc(s.x,s.y,s.r,0,6.283); g.fill();
    }
  }
  function spawnShot(){
    const ang = (18+Math.random()*24)*Math.PI/180 * (Math.random()<.5?1:-1) + (Math.random()<.5?0:Math.PI);
    const dir = Math.cos(ang)>0 ? 1 : -1, sp = 650+Math.random()*450;
    shots.push({x: dir>0 ? Math.random()*W*.6 : W*.4+Math.random()*W*.6, y: Math.random()*H*.45, vx: dir*Math.abs(Math.cos(ang))*sp, vy: Math.abs(Math.sin(ang))*sp, life:0, max:.7+Math.random()*.6, len:110+Math.random()*120});
  }
  function drawShots(dt){
    shots = shots.filter(s=>s.life<s.max);
    for(const s of shots){
      s.life+=dt; s.x+=s.vx*dt; s.y+=s.vy*dt;
      const k = Math.sin(Math.PI*Math.min(1,s.life/s.max)), v=Math.hypot(s.vx,s.vy), tx=s.x-s.vx/v*s.len, ty=s.y-s.vy/v*s.len;
      const gr = g.createLinearGradient(s.x,s.y,tx,ty); gr.addColorStop(0,"rgba(255,255,255,"+(.95*k)+")"); gr.addColorStop(1,"rgba(180,200,255,0)");
      g.strokeStyle=gr; g.lineWidth=1.6; g.lineCap="round"; g.beginPath(); g.moveTo(s.x,s.y); g.lineTo(tx,ty); g.stroke();
      g.fillStyle="rgba(255,255,255,"+k+")"; g.beginPath(); g.arc(s.x,s.y,1.4,0,6.283); g.fill();
    }
  }
  function spawnComet(){
    const ltr = Math.random()<.5, y0 = H*(.55+Math.random()*.25);
    comet = {x: ltr ? -60 : W+60, y: y0, vx: (ltr?1:-1)*(W+120)/(16+Math.random()*6), vy: -(H*.08)/18, life:0};
  }
  function drawComet(dt){
    if(!comet) return;
    comet.life+=dt; comet.x+=comet.vx*dt; comet.y+=comet.vy*dt;
    if(comet.x<-200 || comet.x>W+200){ comet=null; return; }
    const v=Math.hypot(comet.vx,comet.vy), ux=-comet.vx/v, uy=-comet.vy/v, nx=-uy, ny=ux, L=Math.min(380,W*.35);
    const fade = Math.min(1, comet.life/1.5);
    // dust tail: soft widening cone
    const gx=comet.x+ux*L, gy=comet.y+uy*L;
    const gr=g.createLinearGradient(comet.x,comet.y,gx,gy); gr.addColorStop(0,"rgba(215,230,255,"+(.42*fade)+")"); gr.addColorStop(1,"rgba(160,190,255,0)");
    g.fillStyle=gr; g.beginPath(); g.moveTo(comet.x+nx*3,comet.y+ny*3); g.lineTo(gx+nx*26,gy+ny*26+10); g.lineTo(gx-nx*12,gy-ny*12); g.lineTo(comet.x-nx*3,comet.y-ny*3); g.closePath(); g.fill();
    // ion tail: thin bright streak
    const gi=g.createLinearGradient(comet.x,comet.y,comet.x+ux*L*1.15,comet.y+uy*L*1.15); gi.addColorStop(0,"rgba(190,230,255,"+(.7*fade)+")"); gi.addColorStop(1,"rgba(120,190,255,0)");
    g.strokeStyle=gi; g.lineWidth=1.4; g.beginPath(); g.moveTo(comet.x,comet.y); g.lineTo(comet.x+ux*L*1.15,comet.y+uy*L*1.15); g.stroke();
    // glowing head
    const gh=g.createRadialGradient(comet.x,comet.y,0,comet.x,comet.y,16); gh.addColorStop(0,"rgba(255,255,255,"+fade+")"); gh.addColorStop(.3,"rgba(200,225,255,"+(.5*fade)+")"); gh.addColorStop(1,"rgba(160,200,255,0)");
    g.fillStyle=gh; g.beginPath(); g.arc(comet.x,comet.y,16,0,6.283); g.fill();
  }
  function frame(now){
    if(!running) return;
    const dt = Math.min(.05, (now-(last||now))/1000); last=now; t+=dt;
    g.clearRect(0,0,W,H); drawStars();
    if(t>nextShot){ spawnShot(); nextShot=t+2.2+Math.random()*4; }
    if(!comet && t>nextComet){ spawnComet(); nextComet=t+28+Math.random()*16; }
    drawComet(dt); drawShots(dt);
    raf=requestAnimationFrame(frame);
  }
  addEventListener("resize",()=>{ if(c.hidden) return; size(); if(reduce){ g.clearRect(0,0,W,H); drawStars(); } });
  document.addEventListener("visibilitychange",()=>{ if(document.hidden){ cancelAnimationFrame(raf); } else if(running){ last=0; raf=requestAnimationFrame(frame); } });
  return {
    start(){ c.hidden=false; if(!W || W!==innerWidth || H!==innerHeight) size(); if(reduce){ g.clearRect(0,0,W,H); drawStars(); return; } if(!running){ running=true; last=0; raf=requestAnimationFrame(frame); } },
    stop(){ running=false; cancelAnimationFrame(raf); c.hidden=true; }
  };
})();

/* ---------- product modal ---------- */
let mv=null, cur=null, sel={item:"tee",color:"Black",size:"M"}, modalPushed=false;
const SIZES=["S","M","L","XL","2XL","3XL","4XL","5XL"];
const SIZE_CHART={ tee:{w:[18,20,22,24,26,28,30,32], l:[28,29,30,31,32,33,34,35], note:"Bella+Canvas 3001 unisex tee"}, hoodie:{w:[20,22,24,26,28,30,32,34], l:[27,28,29,30,31,32,33,34], note:"Gildan 18500 unisex hoodie"} };
const VIDEO_FOR={d1:"CHvJvQC1JUw",d2:"gfCPkLQdlvo",d3:"8u3sv4pJK1k",d4:"AoZg6VEqOLA",d5:"VGvNj6tGXog",d6:"H_JIOlExdLc",d7:"rjovJk6Hsug",g1:"_xkVhfNilaI",g2:"GHBE-wYqalI",g3:"VGvNj6tGXog",g4:"gI-uTdCoTeM",g5:"LUbzQzFMyR0",g6:"kWhpzcWpQM0",g7:"bDNseOPRsGg",g8:"H_JIOlExdLc",r1:"N-iNc-HgtRE",r2:"THTsVSDhexE",r3:"3eJIPAVQwN8"};
const VIDEO_T={d5:6886,r3:15881};
const BACKPRINT=new Set(["d5","g1","g2","g3","g8","r1","g6","p4"]); let side="both";
const VIDEO_NAME={d5:"Spiritual Healing Meditation • 432 Hz Frequency Tunes",r3:"Deep Sleep Meditation • 963 Hz Solfeggio Healing Frequency"};
const sizeUp = s => ITEMS[sel.item].apparel ? ({"2XL":4,"3XL":4,"4XL":8,"5XL":8}[s]||0) : 0;
const priceNow = () => ITEMS[sel.item].price + sizeUp(sel.size);
function openModal(id, fromRoute, pre){
  cur = DESIGNS.find(d=>d.id===id); if(!cur) return; side="both";
  const items = cur.items || ALL;
  sel = {item:items[0], color: cardColor(cur), size:"M"};
  if (pre && pre.item && items.includes(pre.item)) sel.item = pre.item;
  $("#mTitle").textContent = cur.name; $("#mFrom").textContent = cur.from;
  $("#mItems").innerHTML = items.map(k=>'<button type="button" class="item" data-item="'+k+'">'+ITEMS[k].label+'<small>'+money(ITEMS[k].price)+'</small></button>').join("");
  $("#mItems").querySelectorAll(".item").forEach(b=>b.onclick=()=>{sel.item=b.dataset.item;refresh();});
  $("#mSizes").innerHTML = SIZES.map(s=>'<button type="button" class="pill" data-size="'+s+'">'+s+'</button>').join("");
  $("#mSizes").querySelectorAll(".pill").forEach(b=>b.onclick=()=>{sel.size=b.dataset.size;refresh(true);});
  $("#modal").hidden=false; document.body.style.overflow="hidden";
  $("#modal .sheet").scrollTop=0;
  if(!fromRoute){ history.pushState({m:id},"","#shop/"+id); modalPushed=true; }
  closeZoom();
  if (pre && pre.color){ const want=String(pre.color).toLowerCase(); const c=colorsFor().find(x=>slug(x)===want||x.toLowerCase()===want); if(c) sel.color=c; }
  refresh();
  $("#mBack").focus({preventScroll:true});
  document.title = cur.name+" · Native Tunes Shop";
}
function colorsFor(){
  if (isApparel(sel.item)) return itemColors(cur, sel.item);
  if (sel.item==="mug") return ["White"];
  if (sel.item==="tote") return ["Natural"];
  return [];
}
function refresh(noRebuild){
  { const maxS=(sel.item==="hoodie"&&BACKPRINT.has(cur.id))?6:(sel.item==="tee"&&sel.color==="Purple")?7:8; $("#mSizes").querySelectorAll(".pill").forEach((b,k)=>b.hidden=k>=maxS); if(SIZES.indexOf(sel.size)>=maxS) sel.size=SIZES[maxS-1]; }
  const cols = colorsFor();
  if (cols.length && !cols.includes(sel.color)) sel.color = cols[0];
  $("#mColors").parentElement.hidden = !cols.length;
  $("#mColors").innerHTML = cols.map(c=>'<button type="button" class="pill" data-color="'+c+'"><span style="display:inline-block;width:14px;height:14px;border-radius:50%;margin-right:8px;vertical-align:-2px;background:'+COLOR_HEX[c]+';border:1px solid #c9c6bd"></span>'+c+'</button>').join("");
  $("#mColors").querySelectorAll(".pill").forEach(b=>{ b.setAttribute("aria-pressed", b.dataset.color===sel.color); b.onclick=()=>{sel.color=b.dataset.color;refresh();}; });
  $("#mItems").querySelectorAll(".item").forEach(b=>b.setAttribute("aria-pressed", b.dataset.item===sel.item));
  $("#mSizes").querySelectorAll(".pill").forEach(b=>b.setAttribute("aria-pressed", b.dataset.size===sel.size));
  $("#sizeOpt").hidden = !ITEMS[sel.item].apparel;
  $("#mPrice").textContent = money(priceNow());
  $("#mCare").textContent = sel.item==="tee"
    ? "Soft, pre-shrunk 100% combed ringspun cotton (Heather Gray is a cotton blend). Printed when you order. Wash cold inside out, tumble dry low."
    : sel.item==="hoodie" ? "Cozy cotton-poly fleece pullover hoodie with a front pocket. Printed when you order. Wash cold inside out, tumble dry low."
    : sel.item==="mug" ? "Glossy ceramic, dishwasher and microwave safe. Printed when you order."
    : "Printed when you order and shipped in about 3 to 7 business days.";
  if(BACKPRINT.has(cur.id)&&(sel.item==="tee"||sel.item==="hoodie")) $("#mCare").textContent = "Full design printed on the back, with "+(cur.id==="p4"?"a gold Bitcoin coin":"Native Tunes")+" on the left chest. " + $("#mCare").textContent;
  const ch=SIZE_CHART[sel.item]; $("#sizeGuide").hidden=!ch;
  if(ch) $("#sizeTable").innerHTML='<tr><th>Size</th>'+SIZES.map(s=>"<th>"+s+"</th>").join("")+'</tr><tr><td>Width</td>'+ch.w.map(v=>"<td>"+v+"</td>").join("")+'</tr><tr><td>Length</td>'+ch.l.map(v=>"<td>"+v+"</td>").join("")+"</tr>";
  $("#bundleHint").hidden = !(sel.item==="tee"||sel.item==="mug");
  const vid=VIDEO_FOR[cur.id]||"rjovJk6Hsug", vrow=VIDS.find(v=>v[0]===vid);
  $("#mListen").href="https://www.youtube.com/watch?v="+vid+(VIDEO_T[cur.id]?"&t="+VIDEO_T[cur.id]+"s":""); $("#mListenImg").src="https://i.ytimg.com/vi/"+vid+"/mqdefault.jpg"; $("#mListenTitle").textContent=VIDEO_NAME[cur.id]||(vrow?vrow[1]:"Native Tunes on YouTube");
  $("#zoomImg").src = artFor(cur, sel.color, sel.item);
  if (noRebuild) return;
  const still = isApparel(sel.item);
  $("#still").hidden = !still; $("#thumbs").hidden = !still;
  $("#badge360").hidden = still; $("#spinToggle").hidden = still;
  $("#zoomArt").textContent = "Zoom into the art";
  if (still){
    if(mv) mv.stop();
    const bp=BACKPRINT.has(cur.id)&&(sel.item==="tee"||sel.item==="hoodie"); $("#sideSw").hidden=!bp;
    const si=$("#stillImg"); si.src = bp&&side!=="back" ? mock(cur, sel.item, sel.color).replace(".webp", side==="front"?"-front.webp":"-combo.webp") : mock(cur, sel.item, sel.color); si.alt = cur.name+" "+ITEMS[sel.item].label.toLowerCase()+" in "+sel.color.toLowerCase()+(bp?(side==="front"?", front: Native Tunes on the left chest":side==="back"?", back: full design":", back and front"):"");
    $("#sideSw").querySelectorAll("button").forEach(x=>{ x.setAttribute("aria-pressed", x.dataset.s===side); x.onclick=()=>{ side=x.dataset.s; refresh(); }; });
    $("#thumbs").innerHTML = cols.map(c=>'<button type="button" data-c="'+c+'" aria-label="'+c+'" title="'+c+'"><img alt="" src="'+mock(cur, sel.item, c)+'"></button>').join("");
    $("#thumbs").querySelectorAll("button").forEach(b=>{ b.setAttribute("aria-pressed", b.dataset.c===sel.color); b.onclick=()=>{ sel.color=b.dataset.c; refresh(); }; });
  } else {
    if(!mv && window.THREE){ mv=makeViewer($("#viewer"),{zoom:true, stopOnDrag:true, speed:2.4, onStop:()=>$("#spinToggle").textContent="Resume spin"}); }
    if(mv){ mv.ctl.autoRotate=!reduce; $("#spinToggle").textContent=reduce?"Start spin":"Pause spin"; mv.ctl.reset();
      mv.set(buildProduct(sel.item, Object.assign({}, cur, {img: artFor(cur, sel.color, sel.item)}), sel.color)); mv.start(); }
  }
}
function hideModal(){ $("#modal").hidden=true; $("#share").hidden=true; document.body.style.overflow=""; mv&&mv.stop(); document.title="Native Tunes Shop"; }
function closeModal(){
  if (modalPushed){ modalPushed=false; history.back(); return; }   /* phone back button and this button behave the same */
  hideModal();
  if (/^#shop\//.test(location.hash)) history.replaceState(null,"","#shop");
}
$("#mClose").onclick=closeModal;
$("#mBack").onclick=closeModal;
$("#modal").addEventListener("click",e=>{ if(e.target.id==="modal") closeModal(); });
document.addEventListener("keydown",e=>{ if(e.key==="Escape"){ if(!$("#share").hidden) $("#share").hidden=true; else if(!$("#zoomLayer").hidden) closeZoom(); else if(!$("#modal").hidden) closeModal(); else if(!$("#drawer").hidden) $("#drawer").hidden=true; } });
$("#spinToggle").onclick=()=>{ if(!mv) return; mv.ctl.autoRotate=!mv.ctl.autoRotate; $("#spinToggle").textContent=mv.ctl.autoRotate?"Pause spin":"Resume spin"; };

/* zoom: magnifier that follows the pointer (art, or the shirt photo when you tap it) */
const zl=$("#zoomLayer"), zi=$("#zoomImg");
function closeZoom(){ zl.hidden=true; $("#zoomArt").textContent="Zoom into the art"; }
function openZoom(src){ zi.src=src; zl.hidden=false; zi.style.transform="translate(-50%,-50%) scale(1)"; $("#zoomArt").textContent = isApparel(sel.item) ? "Back to photo" : "Back to 360° view"; }
$("#zoomArt").onclick=()=>{ if(zl.hidden) openZoom(artFor(cur, sel.color, sel.item)); else closeZoom(); };
$("#still").addEventListener("click",e=>{ if(e.target.closest(".thumbs")) return; openZoom($("#stillImg").src); });
zl.addEventListener("pointermove",e=>{ const r=zl.getBoundingClientRect(); const x=(e.clientX-r.left)/r.width-.5, y=(e.clientY-r.top)/r.height-.5; zi.style.transform="translate(calc(-50% + "+(-x*120)+"%), calc(-50% + "+(-y*120)+"%)) scale(2.6)"; });
zl.addEventListener("pointerleave",()=>zi.style.transform="translate(-50%,-50%) scale(1)");
zl.addEventListener("click",closeZoom);

/* ---------- share sheet ---------- */
const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
function copyText(txt){
  if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(txt).catch(()=>legacyCopy(txt));
  legacyCopy(txt); return Promise.resolve();
}
function legacyCopy(txt){ const t=$("#shUrl"); t.value=txt; t.select(); try{ document.execCommand("copy"); }catch(e){} }
const ICON = (bg, label) => '<i style="background:'+bg+'">'+label+'</i>';
function openShare(){
  const url = location.origin + "/#shop/" + cur.id;
  const text = cur.name + " · Native Tunes";
  const img = isApparel(sel.item) ? mock(cur, sel.item, sel.color) : artFor(cur, sel.color, sel.item);
  const e = encodeURIComponent, msg = e(text+" "+url);
  $("#shImg").src = img; $("#shName").textContent = cur.name; $("#shUrl").value = url;
  const L = [
    ["Text message", "sms:"+(/iPhone|iPad|iPod/i.test(navigator.userAgent)?"&":"?")+"body="+msg, "#34c759", "✉"],
    ["WhatsApp", "https://wa.me/?text="+msg, "#25d366", "W"],
    ["Email", "mailto:?subject="+e(text)+"&body="+e("I found this and thought of you: "+url), "#5f6b7a", "@"],
    ["Messenger", isMobile ? "fb-messenger://share/?link="+e(url) : "https://www.facebook.com/sharer/sharer.php?u="+e(url), "#0a7cff", "m"],
    ["Facebook", "https://www.facebook.com/sharer/sharer.php?u="+e(url), "#1877f2", "f"],
    ["X", "https://twitter.com/intent/tweet?text="+e(text)+"&url="+e(url), "#000", "𝕏"],
    ["Instagram", "copy:https://www.instagram.com/", "radial-gradient(circle at 30% 107%,#fdf497 0%,#fd5949 45%,#d6249f 60%,#285AEB 90%)", "IG"],
    ["TikTok", "copy:https://www.tiktok.com/upload", "#111", "♪"],
    ["Pinterest", "https://pinterest.com/pin/create/button/?url="+e(url)+"&media="+e(location.origin+"/"+img)+"&description="+e(text), "#e60023", "P"],
    ["Reddit", "https://www.reddit.com/submit?url="+e(url)+"&title="+e(text), "#ff4500", "r"]
  ];
  const grid = $("#shGrid");
  grid.innerHTML = L.map(([n,href,bg,lab])=> href.startsWith("copy:")
      ? '<button type="button" data-open="'+href.slice(5)+'" data-n="'+n+'">'+ICON(bg,lab)+n+'</button>'
      : '<a href="'+href+'" target="_blank" rel="noopener">'+ICON(bg,lab)+n+'</a>').join("")
    + (navigator.share ? '<button type="button" id="shMore">'+ICON("#3b4252","⋯")+'More apps</button>' : "");
  grid.querySelectorAll("[data-open]").forEach(b=>b.onclick=()=>{ copyText(url).then(()=>toast("Link copied. Paste it into "+b.dataset.n+".")); window.open(b.dataset.open,"_blank","noopener"); });
  const more = $("#shMore"); if(more) more.onclick=()=>{ navigator.share({title:text, text:text, url:url}).catch(()=>{}); };
  $("#share").hidden=false; $("#shCopy").textContent="Copy link"; $("#shCopy").focus();
}
$("#mShare").onclick=openShare;
$("#shCopy").onclick=()=>{ copyText($("#shUrl").value).then(()=>{ $("#shCopy").textContent="Copied!"; toast("Link copied"); }); };
$("#shClose").onclick=()=>$("#share").hidden=true;
$("#share").addEventListener("click",e=>{ if(e.target.id==="share") $("#share").hidden=true; });

/* ---------- cart ---------- */
let cart=[];
try{ cart = JSON.parse(localStorage.getItem("nt-cart")||"[]").filter(l=>l.item!=="sticker"); }catch(e){ cart=[]; }
let cartSyncT=null;
function saveCart(){ try{ localStorage.setItem("nt-cart", JSON.stringify(cart)); }catch(e){} if(me){ clearTimeout(cartSyncT); cartSyncT=setTimeout(pushCart,1500); } }
function pushCart(){ try{ fetch("/api/account/cart",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({lines:cart})}); }catch(e){} }
async function syncCartAfterLogin(){ if(!me) return; if(cart.length){ pushCart(); return; } try{ const j=await (await fetch("/api/account/cart",{cache:"no-store"})).json(); if(j.ok && j.lines && j.lines.length){ cart=j.lines.filter(l=>l.item!=="sticker"); try{ localStorage.setItem("nt-cart", JSON.stringify(cart)); }catch(e){} renderCart(); } }catch(e){} }
let promo=null;
try{ promo = JSON.parse(localStorage.getItem("nt-promo")||"null"); }catch(e){ promo=null; }
let shipPromo=null;
try{ shipPromo = JSON.parse(localStorage.getItem("nt-ship")||"null"); }catch(e){ shipPromo=null; }
function savePromo(){ try{ promo ? localStorage.setItem("nt-promo", JSON.stringify(promo)) : localStorage.removeItem("nt-promo"); shipPromo ? localStorage.setItem("nt-ship", JSON.stringify(shipPromo)) : localStorage.removeItem("nt-ship"); }catch(e){} }
const FREE_SHIP=75, AUTO_MIN=100, SHIP=6.95, HOODIE_SHIP=9.95, BUNDLE_OFF=5;
function totals(){
  const sub = cart.reduce((s,l)=>s+l.price*l.qty,0);
  const tees = cart.filter(l=>l.item==="tee").reduce((n,l)=>n+l.qty,0), mugs = cart.filter(l=>l.item==="mug").reduce((n,l)=>n+l.qty,0);
  const bundle = Math.min(tees,mugs)*BUNDLE_OFF;
  const goods = sub - bundle;
  const ship = !cart.length || shipPromo || (promo && promo.owner) ? 0 : (goods>=FREE_SHIP ? 0 : (cart.some(l=>l.item==="hoodie") ? HOODIE_SHIP : SHIP));
  const disc = promo && promo.owner ? 0 : promo && promo.percent ? Math.round(goods*promo.percent)/100 : (promo && promo.amount ? Math.min(goods, promo.amount/100) : 0);
  const auto = !promo && goods>=AUTO_MIN ? Math.round(goods*10)/100 : 0;
  return {sub, bundle, goods, ship, disc, auto, total: Math.max(0, goods - disc - auto) + ship};
}
function renderCart(){
  $("#cartCount").textContent = cart.reduce((n,l)=>n+l.qty,0);
  const L=$("#lines");
  if(!cart.length){ L.innerHTML='<p class="note">Your cart is empty. Tap any design in the shop to add it.</p>'; }
  else { L.innerHTML = cart.map((l,i)=>'<div class="line"><img alt="" src="'+l.img+'"><div><b></b><br><span class="note"></span></div><span style="font-variant-numeric:tabular-nums">'+money(l.price*l.qty)+'</span><button type="button" data-rm="'+i+'">Remove</button></div>').join("");
    L.querySelectorAll(".line").forEach((el,i)=>{ el.querySelector("b").textContent=cart[i].name; el.querySelector(".note").textContent=cart[i].detail+(cart[i].qty>1?" · ×"+cart[i].qty:""); });
    L.querySelectorAll("[data-rm]").forEach(b=>b.onclick=()=>{ cart.splice(+b.dataset.rm,1); saveCart(); renderCart(); });
  }
  const t = totals();
  const left = Math.max(0, FREE_SHIP - t.goods);
  $("#shipProg").innerHTML = !cart.length ? "" : (left>0 ? "<span>You're <b>"+money(left)+"</b> away from free shipping</span>" : t.goods<AUTO_MIN ? "<span><b>🎉 Free US shipping unlocked.</b> Add <b>"+money(AUTO_MIN-t.goods)+"</b> more for a limited-time extra 10% off</span>" : "<span><b>🎉 Free shipping + extra 10% off unlocked</b></span>") + '<span class="bar"><i style="width:'+Math.min(100, (left>0 ? t.goods/FREE_SHIP : t.goods/AUTO_MIN)*100)+'%"></i></span>';
  const rows = [["Subtotal", money(t.sub), ""]];
  if (t.bundle) rows.push(["Tee + mug bundle", "−"+money(t.bundle), "save"]);
  if (t.disc) rows.push(["Promo "+promo.code+(promo.percent?" ("+promo.percent+"% off)":""), "−"+money(t.disc), "save"]);
  if (t.auto) rows.push(["Limited-time extra 10% off ($100+)", "−"+money(t.auto), "save"]);
  if (cart.length) rows.push([shipPromo ? "Shipping ("+shipPromo.code+")" : "Shipping", t.ship ? money(t.ship) : "Free", t.ship ? "" : "save"]);
  $("#sumLines").innerHTML = rows.map(r=>'<div class="'+r[2]+'"><span>'+r[0].replace(/</g,"&lt;")+'</span><span>'+r[1]+'</span></div>').join("");
  $("#subtotal").textContent = money(t.total);
  const pm=$("#promoMsg");
  const esc=x=>String(x).replace(/</g,"&lt;"), parts=[];
  if (promo) parts.push("✓ "+(promo.owner?"Owner code":esc(promo.code))+" applied"+(promo.owner?" · items at Printify cost + free shipping (final prices shown at checkout)":"")+(promo.firstOrderOnly?" · first order only, one use per customer":"")+'<button type="button" id="promoRemove">Remove</button>');
  if (shipPromo) parts.push("✓ "+esc(shipPromo.code)+" · free shipping"+'<button type="button" id="shipRemove">Remove</button>');
  if (parts.length){ pm.className="note promo-ok"; pm.innerHTML=parts.join("<br>");
    if(promo) $("#promoRemove").onclick=()=>{ promo=null; savePromo(); $("#promoInput").value=""; renderCart(); };
    if(shipPromo) $("#shipRemove").onclick=()=>{ shipPromo=null; savePromo(); $("#promoInput").value=""; renderCart(); }; }
  else if (pm.classList.contains("promo-ok")){ pm.className="note"; pm.textContent=""; }
}
async function applyPromo(code){
  const pm=$("#promoMsg"); code=(code||"").trim().toUpperCase();
  if(!code){ pm.className="note"; pm.textContent="Enter a promo code."; return; }
  pm.className="note"; pm.textContent="Checking…";
  try{
    const r=await fetch("/api/promo?code="+encodeURIComponent(code)); const j=await r.json();
    if(r.ok && j.ok && j.freeShipping){ shipPromo={code:j.code}; savePromo(); $("#promoInput").value=""; renderCart(); toast("Free shipping applied"); }
    else if(r.ok && j.ok && j.owner){ promo={code:j.code, owner:true}; shipPromo=null; savePromo(); $("#promoInput").value=""; renderCart(); toast("Owner code applied: items at cost + free shipping"); }
    else if(r.ok && j.ok){ promo={code:j.code, percent:j.percent, amount:j.amount, firstOrderOnly:j.firstOrderOnly}; savePromo(); $("#promoInput").value=""; renderCart(); toast("Promo code applied"); }
    else if(r.status===503){ promo={code, percent:null, amount:null}; savePromo(); renderCart(); pm.className="note promo-ok"; pm.textContent="Code saved. It will be checked at secure checkout."; }
    else { pm.className="note"; pm.textContent=j.error||"That code isn't valid."; }
  }catch(e){ pm.className="note"; pm.textContent="Couldn't check the code right now. You can also enter it on the checkout page."; }
}
$("#promoApply").onclick=()=>applyPromo($("#promoInput").value);
$("#promoInput").addEventListener("keydown",e=>{ if(e.key==="Enter"){ e.preventDefault(); applyPromo(e.target.value); } });
$("#addCart").onclick=()=>{
  const it=ITEMS[sel.item];
  const detail=[it.label, colorsFor().length?sel.color:null, it.apparel?sel.size:null].filter(Boolean).join(" · ");
  const key=cur.id+"|"+detail; const ex=cart.find(l=>l.key===key);
  if(ex) ex.qty++; else cart.push({key, id:cur.id, item:sel.item, color:colorsFor().length?sel.color:null, size:it.apparel?sel.size:null, name:cur.name, detail, img:(isApparel(sel.item)?mock(cur,sel.item,sel.color):artFor(cur,sel.color,sel.item)), price:priceNow(), qty:1});
  saveCart(); renderCart(); toast("Added to cart: "+cur.name+" "+it.label.toLowerCase());
};
$("#cartBtn").onclick=()=>{ $("#drawer").hidden=false; $("#dClose").focus(); };
$("#dClose").onclick=()=>$("#drawer").hidden=true;
$("#checkout").onclick=async()=>{
  const note=$("#checkoutNote");
  if(!cart.length){ note.textContent="Add something to your cart first."; return; }
  const lines=cart.filter(l=>l.id&&l.item).map(l=>({id:l.id,item:l.item,color:l.color,size:l.size,qty:l.qty}));
  if(lines.length!==cart.length){ note.textContent="Please remove and re-add older items in your cart, then try again."; return; }
  note.textContent="Opening secure checkout…"; $("#checkout").disabled=true;
  try{
    const r=await fetch("/api/checkout",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(Object.assign({lines}, promo?{promo:promo.code}:{}, shipPromo?{shipCode:shipPromo.code}:{}))});
    const j=await r.json(); if(j.url){ location.href=j.url; return; }
    if(/shipping code/i.test(j.error||"")){ shipPromo=null; savePromo(); renderCart(); note.textContent=j.error+" It was removed, so you can try again."; $("#checkout").disabled=false; return; }
    if(/promo/i.test(j.error||"")){ promo=null; savePromo(); renderCart(); note.textContent=j.error+" It was removed, so you can try again."; $("#checkout").disabled=false; return; }
    if(/owner|log in|no longer available|Printify/i.test(j.error||"")){ note.textContent=j.error; $("#checkout").disabled=false; return; }
    throw new Error(j.error||"Checkout failed");
  }catch(e){ note.textContent="Checkout couldn't open right now. Please try again in a minute, or email customerservice@nativetunesmedia.com."; }
  $("#checkout").disabled=false;
};
if(/[?&]order=success/.test(location.search)){ cart=[]; saveCart(); promo=null; shipPromo=null; savePromo(); setTimeout(()=>toast("Thank you! Your order is confirmed. A receipt is on its way to your email, and we'll email your tracking number when it ships."),600); try{fetch("/api/order-complete",{method:"POST"});}catch(e){} }

/* ---------- customer accounts ---------- */
var me=null;
const firstName=n=>String(n||"").trim().split(/\s+/)[0]||"";
function renderAcct(){
  const b=$("#acctBtn"); b.textContent = me ? "Welcome back, "+(firstName(me.name)||me.email)+"!" : "Log in";
  b.setAttribute("aria-label", me ? "Your account" : "Log in or create an account");
  const o=$("#acctOffer"); if(!o) return;
  o.innerHTML = me ? "Checking out as <b>"+esc(me.name||me.email)+"</b>. Your saved details fill in at checkout."
    : 'Check out faster next time: <button type="button" class="link" data-a="login">Log in</button> or <button type="button" class="link" data-a="signup">create an account</button> to save your name, address and phone. Optional.';
  o.querySelectorAll("[data-a]").forEach(x=>x.onclick=()=>openAcct(x.dataset.a));
}
async function loadMe(){ try{ const r=await fetch("/api/account/me",{cache:"no-store"}); const j=await r.json(); me=j.ok?j.user:null; }catch(e){ me=null; } renderAcct(); if(me && !/[?&]order=success/.test(location.search)) syncCartAfterLogin(); }
const F=(n,l,t,v,extra)=>'<label class="'+(extra||"")+'">'+l+'<input name="'+n+'" type="'+(t||"text")+'" value="'+esc(v||"")+'"'+(t==="password"?' autocomplete="'+(n==="password"?"current-password":"new-password")+'"':"")+'></label>';
function profileFields(p){ p=p||{}; return F("name","Full name","text",p.name)+F("phone","Phone","tel",p.phone)+F("line1","Street address","text",p.line1)+F("line2","Apt, suite (optional)","text",p.line2)+F("city","City","text",p.city,"half")+F("state","State","text",p.state,"half")+F("zip","ZIP code","text",p.zip,"half")+'<label class="half"></label>'; }
function openAcct(view, pre){
  const B=$("#acctBody"); pre=pre||{};
  if(view==="login") B.innerHTML='<h2 id="acctTitle">Log in</h2><p class="sub">Welcome back to Native Tunes.</p><form id="aForm">'+F("email","Email","email",pre.email)+F("password","Password","password")+'<p class="err" id="aErr"></p><div class="row"><button class="btn btn-gold" type="submit">Log in</button><button type="button" class="link" id="aForgot">Forgot password?</button></div><div class="row"><button type="button" class="link" data-a="signup">New here? Create an account</button></div></form>';
  else if(view==="forgot") B.innerHTML='<h2 id="acctTitle">Reset your password</h2><p class="sub">Enter the email on your account. We\'ll email you a 6-digit code that works for 15 minutes.</p><form id="aForm">'+F("email","Email","email",pre.email)+'<p class="err" id="aErr"></p><div class="row"><button class="btn btn-gold" type="submit">Email me a code</button><button type="button" class="link" data-a="login">Back to log in</button></div></form>';
  else if(view==="reset") B.innerHTML='<h2 id="acctTitle">Check your email</h2><p class="sub">If <b>'+esc(pre.email||"")+'</b> has an account, we just sent it a 6-digit code. It expires in 15 minutes. Check your spam folder if you don\'t see it.</p><form id="aForm"><input type="hidden" name="email" value="'+esc(pre.email||"")+'">'+F("code","6-digit code","text")+F("npw","New password (8+ characters)","password")+'<p class="err" id="aErr"></p><div class="row"><button class="btn btn-gold" type="submit">Set new password</button><button type="button" class="link" id="aResend">Resend code</button></div><div class="row"><button type="button" class="link" data-a="login">Back to log in</button></div></form>';
  else if(view==="signup") B.innerHTML='<h2 id="acctTitle">Create your account</h2><p class="sub">'+(pre.msg||"Save your name, address and phone for faster checkout next time.")+'</p><form id="aForm">'+F("email","Email","email",pre.email)+F("password","Choose a password (8+ characters)","password")+profileFields(pre)+'<label class="chk"><input type="checkbox" name="marketing" checked><span>Email me special offers and new designs. You can unsubscribe anytime.</span></label><p class="err" id="aErr"></p><div class="row"><button class="btn btn-gold" type="submit">Create account</button><button type="button" class="link" data-a="login">Already have an account? Log in</button></div><p class="note" style="grid-column:span 2;font-size:12px">By creating an account you agree to our <a href="#privacy">Privacy policy</a>.</p></form>';
  else B.innerHTML='<h2 id="acctTitle">Welcome back, '+esc(firstName(me.name)||me.email)+'!</h2><p class="sub">Logged in as '+esc(me.email)+'. Update your saved details for checkout.</p><form id="aForm">'+profileFields(me)+'<label class="chk"><input type="checkbox" name="marketing"'+(me.marketing?" checked":"")+'> Email me special offers and new designs.</label><p class="err" id="aErr"></p><div class="row"><button class="btn btn-gold" type="submit">Save</button><button type="button" class="link" id="aOut">Log out</button>'+(me.owner?'<a class="link" href="/api/account/export">Download customer list (CSV)</a>':'')+'</div></form><h3 class="acct-h3">Your orders</h3><div id="aOrders" class="acct-orders"><p class="note">Loading your orders…</p></div>';
  B.querySelectorAll("[data-a]").forEach(x=>x.onclick=()=>openAcct(x.dataset.a, pre));
  const fg=$("#aForgot"); if(fg) fg.onclick=()=>{ const em=$("#aForm").email.value; openAcct("forgot",Object.assign({},pre,{email:em})); };
  const cd=B.querySelector('input[name=code]'); if(cd){ cd.setAttribute("inputmode","numeric"); cd.setAttribute("autocomplete","one-time-code"); cd.maxLength=6; }
  const rs=$("#aResend"); if(rs){ const wait=s=>{ rs.disabled=true; const t=setInterval(()=>{ s--; rs.textContent=s>0?"Resend code ("+s+"s)":"Resend code"; if(s<=0){ clearInterval(t); rs.disabled=false; } },1000); rs.textContent="Resend code ("+s+"s)"; }; wait(60);
    rs.onclick=async()=>{ $("#aErr").textContent=""; try{ const r=await fetch("/api/account/forgot",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({email:pre.email})}); const j=await r.json(); if(j.ok){ toast("A new code is on its way. Use the newest one."); wait(60); } else $("#aErr").textContent=j.error||"Please try again in a minute."; }catch(e){ $("#aErr").textContent="Please try again in a minute."; } }; }
  const ao=$("#aOrders"); if(ao) loadOrders(ao);
  const out=$("#aOut"); if(out) out.onclick=async()=>{ try{ await fetch("/api/account/logout",{method:"POST"}); }catch(e){} me=null; renderAcct(); closeAcct(); toast("You're logged out"); };
  const f=$("#aForm"); f.onsubmit=async e=>{ e.preventDefault(); const d=Object.fromEntries(new FormData(f)); d.marketing=!!f.marketing && f.marketing.checked; if(pre.source) d.source=pre.source;
    const btn=f.querySelector("button[type=submit]"); btn.disabled=true; $("#aErr").textContent="";
    try{ const path={login:"login",signup:"signup",forgot:"forgot",reset:"reset"}[view]||"update"; if(view==="reset"){ d.password=d.npw; delete d.npw; } const r=await fetch("/api/account/"+path,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(d)}); const j=await r.json();
      if(j.ok && view==="forgot"){ openAcct("reset",Object.assign({},pre,{email:d.email})); return; }
      if(j.ok){ const wasIn=!!me; me=j.user; renderAcct(); closeAcct(); if(!wasIn) syncCartAfterLogin(); toast(view==="account"?"Saved":view==="reset"?"Password updated. Welcome back, "+(firstName(me.name)||me.email)+"!":"Welcome back, "+(firstName(me.name)||me.email)+"!"); } else $("#aErr").textContent=j.error||"Something went wrong. Please try again."; }
    catch(err){ $("#aErr").textContent="Something went wrong. Please try again."; }
    btn.disabled=false; };
  $("#acctModal").hidden=false; setTimeout(()=>{ const i=f.querySelector("input"); i&&i.focus(); },50);
}
async function loadOrders(el){
  try{ const j=await (await fetch("/api/account/orders",{cache:"no-store"})).json();
    if(!j.ok){ el.innerHTML='<p class="note">Your orders couldn\'t load right now. Please try again later.</p>'; return; }
    if(!j.orders.length){ el.innerHTML='<p class="note">No orders yet. Orders you place with this email will show up here.</p>'; return; }
    el.innerHTML=j.orders.map(o=>'<div class="acct-order"><div class="ao-top"><b>'+new Date(o.date).toLocaleDateString("en-US",{month:"short",day:"numeric",year:"numeric"})+'</b><span class="ao-st ao-'+esc(o.status.toLowerCase().replace(/\W+/g,"-"))+'">'+esc(o.status)+'</span></div><div class="note">Order '+esc(o.number)+' · '+money(o.total/100)+'</div><ul>'+o.items.map(i=>'<li>'+esc(i.name)+(i.qty>1?' × '+i.qty:'')+'</li>').join("")+'</ul>'+(o.tracking||[]).map(t=>t.url?'<a class="link" target="_blank" rel="noopener" href="'+esc(t.url)+'">Track package'+(t.carrier?' ('+esc(t.carrier)+')':'')+'</a>':'<span class="note">'+esc((t.carrier||"Tracking")+": "+t.number)+'</span>').join(" ")+'</div>').join("");
  }catch(e){ el.innerHTML='<p class="note">Your orders couldn\'t load right now. Please try again later.</p>'; }
}
function closeAcct(){ $("#acctModal").hidden=true; }
$("#acctBtn").onclick=()=>openAcct(me?"account":"login");
$("#acctClose").onclick=closeAcct;
$("#acctModal").addEventListener("click",e=>{ if(e.target.id==="acctModal") closeAcct(); });
document.addEventListener("keydown",e=>{ if(e.key==="Escape" && !$("#acctModal").hidden) closeAcct(); });
loadMe().then(async()=>{
  const m=location.search.match(/[?&]session_id=([^&]+)/);
  if(m && /[?&]order=success/.test(location.search) && !me){ try{ const r=await fetch("/api/account/from-session?session_id="+m[1]); const j=await r.json();
    if(j.ok && !j.exists) setTimeout(()=>openAcct("signup", Object.assign({}, j.profile, {source:"checkout", msg:"Thanks for your order! Save these details for faster checkout next time: just choose a password."})), 2500); }catch(e){} }
});

/* ---------- email signup ---------- */
$("#joinForm").addEventListener("submit", async e=>{
  e.preventDefault();
  const msg=$("#joinMsg"), em=$("#joinEmail").value.trim();
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(em)){ msg.textContent="Please enter a valid email address."; return; }
  msg.textContent="Joining…";
  try{
    const r=await fetch("/api/subscribe",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({email:em})}); const j=await r.json();
    if(r.ok && j.ok){ msg.innerHTML="You're in! Your code: <b>"+j.code+"</b> 10% off your first order. Enter it in your cart."; $("#joinEmail").value=""; try{localStorage.setItem("nt-joined","1");}catch(_){} }
    else msg.textContent = r.status===503 ? "Sign-ups open in just a moment. Please try again soon." : (j.error||"Something went wrong. Please try again.");
  }catch(_){ msg.textContent="Something went wrong. Please try again."; }
});

renderGrid(); renderCart(); route();
})();
</script>
<script>(function(){var v=document.getElementById("fluteLoop");if(!v)return;v.muted=true;v.defaultMuted=true;v.setAttribute("muted","");function go(){var p=v.play();if(p&&p.catch)p.catch(function(){});}go();v.addEventListener("pause",function(){if(!document.hidden)setTimeout(go,300);});document.addEventListener("visibilitychange",function(){if(!document.hidden)go();});["touchstart","click","scroll","keydown"].forEach(function(e){window.addEventListener(e,go,{passive:true});});})();</script>
</body>
</html>
